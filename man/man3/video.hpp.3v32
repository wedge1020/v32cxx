.TH VIDEO.HPP 3v32 "October 22, 2026" "v32c++ 20261022-dev" "v32c++ Library"
.SH NAME
v32/video.hpp \- C++ helpers for the Vircon32 GPU
.SH SYNOPSIS
.nf
.B #include <v32/video.hpp>
.PP
.B namespace v32 {
.PP
.B "enum BlendMode { BlendAlpha = 0x20, BlendAdd = 0x21, BlendSubtract = 0x22 };"
.PP
.BI "void clear_screen_rgb( int " r ", int " g ", int " b " );"
.BI "void print_xy( int " x ", int " y ", int* " text " );"
.BI "void draw( int " region_id ", int " x ", int " y " );"
.BI "void draw_scaled( int " region_id ", int " x ", int " y ", float " scale " );"
.BI "void set_blending( BlendMode " mode " );"
.BI "void screen_center( Point* " out " );"
.PP
.B class TextureScope {
.BI "    TextureScope( int " texture_id " );"
.B "    ~TextureScope();"
.B };
.PP
.B class Point {
.B "public:"
.B "    int x;"
.B "    int y;"
.B "    Point();"
.BI "    Point( int " px ", int " py " );"
.BI "    void add( const Point& " other " );"
.B };
.PP
.B }
.fi
.SH DESCRIPTION
.I v32/video.hpp
includes the SDK's
.I video.h
(see
.BR video.h (3v32)),
whose functions, colors and constants stay available as they are, and
adds the following in namespace
.BR v32 .
.SS Functions
.TP
.B clear_screen_rgb
Clear the screen to an opaque color given as red, green and blue,
0 to 255.
.TP
.B print_xy
The same as
.BR print_at .
.TP
.B draw
Select region
.I region_id
of the selected texture and draw it with its hotspot at
.RI ( x ", " y ).
.TP
.B draw_scaled
The same, scaled by
.I scale
in both directions. It leaves the drawing scale set to
.IR scale .
.TP
.B set_blending
Set the blending mode from a
.BR BlendMode .
.TP
.B screen_center
Store the center of the screen, (320, 180), in
.IR *out .
.SS TextureScope
A scope guard for the selected texture: the constructor remembers the
selected texture and selects
.IR texture_id ;
the destructor, run when the guard goes out of scope by any path,
selects the remembered one again. Declare it as a local variable.
.SS Point
A pair of
.B int
coordinates, (0, 0) by default.
.B add
adds another point to this one in place. Following the one-word rule
for parameters and results, functions that produce a point take a
.B Point*
to fill instead of returning one.
.SH EXAMPLES
.RS
.nf
#include <v32/video.hpp>
#include <v32/time.hpp>

#define TEX_SPRITES 0
#define REG_SHIP    1

void draw_hud()
{
    v32::TextureScope bios( \-1 );     // the BIOS font texture
    v32::print_xy( 10, 10, "SCORE 0" );
}                                     // texture 0 selected again

void main()
{
    select_texture( TEX_SPRITES );
    select_region( REG_SHIP );
    define_region_center( 0, 0, 31, 31 );

    v32::Point center;
    v32::screen_center( &center );

    while( true )
    {
        v32::clear_screen_rgb( 0, 0, 40 );
        v32::draw( REG_SHIP, center.x, center.y );
        draw_hud();
        end_frame();
    }
}
.fi
.RE
.SH SEE ALSO
.BR video.h (3v32),
