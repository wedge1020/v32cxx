'\" -*- coding: UTF-8 -*-
.TH V32CURSES 3v32 "16 de octubre de 2026" "v32c++ 20261016-dev" "Biblioteca v32c++"
.SH NOMBRE
v32curses \- curses clásico sobre la pantalla de texto de Vircon32
.SH SINOPSIS
.nf
.B #include <curses.h>
.B #include <v32libc.c>
.B #include <v32curses.c>
.PP
.B "WINDOW *stdscr, *curscr;"
.B "int LINES, COLS;"
.PP
.B "WINDOW *initscr( void );"
.B "int     endwin( void );"
.B "int     isendwin( void );"
.BI "WINDOW *newwin( int " lines ", int " cols ", int " begin_y ", int " begin_x " );"
.BI "WINDOW *subwin( WINDOW *" parent ", int " lines ", int " cols ","
.BI "                int " begin_y ", int " begin_x " );"
.BI "int     delwin( WINDOW *" win " );"
.BI "int     mvwin( WINDOW *" win ", int " y ", int " x " );"
.PP
.BI "int wmove( WINDOW *" win ", int " y ", int " x " );"
.BI "int waddch( WINDOW *" win ", chtype " ch " );"
.BI "int waddstr( WINDOW *" win ", char *" s " );"
.BI "int wprintw( WINDOW *" win ", char *" fmt ", ... );"
.BI "int mvwprintw( WINDOW *" win ", int " y ", int " x ", char *" fmt ", ... );"
.BI "int printw( char *" fmt ", ... );"
.BI "int mvprintw( int " y ", int " x ", char *" fmt ", ... );"
.BI "chtype winch( WINDOW *" win " );"
.BI "int wclear( WINDOW *" win " );   " "werase(), wclrtoeol(), wclrtobot() igual"
.BI "int wstandout( WINDOW *" win " );   " "wstandend() igual"
.BI "int wattron( WINDOW *" win ", int " attrs " );   " "wattroff() igual"
.BI "int wrefresh( WINDOW *" win " );"
.BI "int touchwin( WINDOW *" win " );"
.BI "int clearok( WINDOW *" win ", int " flag " );"
.BI "int box( WINDOW *" win ", chtype " vertical ", chtype " horizontal " );"
.BI "int wgetch( WINDOW *" win " );"
.BI "int wgetnstr( WINDOW *" win ", char *" buf ", int " n " );"
.BI "int mvwaddch(), mvwaddstr();  chtype mvwinch();"
.PP
.BI "char *unctrl( chtype " ch " );"
.B "int mvcur(), beep(), flushinp(), baudrate(), erasechar(), killchar();"
.PP
.RB "y las macros de " stdscr ": " move ", " addch ", " addstr ", " inch ", " clear ", " erase ,
.BR clrtoeol ", " clrtobot ", " standout ", " standend ", " attron ", " attroff ", " refresh ,
.BR getch ", " getstr ", " getnstr ", " mvaddch ", " mvaddstr ", " mvinch ;
.BR getyx ", " getmaxyx ", " getmaxy ", " getmaxx ", " getbegyx .
.fi
.SH DESCRIPCIÓN
Este es el curses clásico (4.3BSD y System V) contra el que se escriben los programas de
terminal: ventanas de caracteres, un cursor en cada una y
.B wrefresh
para que la pantalla coincida con ellas. La pantalla es la cuadrícula de 80\(mu24 de
.BR v32term (3v32),
de modo que
.B LINES
vale 24 y
.B COLS
80, y las teclas llegan del mando a través de
.B v32term_key_source
\(em el teclado en pantalla, salvo que el programa instale su propia asignación. Incluye
.I v32curses.c
una sola vez, después de
.IR v32libc.c .
.PP
Las funciones se comportan como en curses, con estas diferencias:
.IP \(bu 2
Un
.B chtype
es el carácter más
.B A_STANDOUT
(también escrito
.BR A_REVERSE ;
vídeo inverso) y un color opcional,
.BI A_INK( n )
con un índice
.B V32INK_
de
.BR v32term (3v32).
.B A_BOLD
y
.B A_NORMAL
valen 0.
.IP \(bu 2
Las llamadas de modo de terminal
.RB ( raw ,
.BR noraw ,
.BR cbreak ,
.BR nocbreak ,
.BR crmode ,
.BR echo ,
.BR noecho ,
.BR nl ,
.BR nonl ,
.BR keypad ,
.BR idlok ,
.BR leaveok ,
.BR scrollok ,
.BR nodelay ,
.BR typeahead ,
.BR halfdelay )
no tienen nada que hacer en una consola; no hacen nada y devuelven
.BR OK .
.IP \(bu 2
.B getstr
lee como máximo 1024 caracteres.
.IP \(bu 2
No hay pares de colores, ni códigos
.BR KEY_ *
aparte de
.B KEY_BACKSPACE
y
.BR KEY_ENTER ,
ni pads ni paneles.
.SS Añadidos
.TP
.B curses_shown
La ventana cuyo refresco cambió por última vez la pantalla: lo que el jugador está viendo,
para el código que necesita saber si hay una ventana emergente a la vista.
.TP
.B curses_ink_hook
Cuando se establece,
.BI "int (*curses_ink_hook)( WINDOW *" win ", int " y ", int " x ", int " ch " )"
elige el color de cada carácter que un refresco pone en pantalla: devuelve un índice
.B V32INK_
o \-1 para conservar el propio del carácter. Da color a un programa monocromo antiguo sin
tocar su código de dibujo.
.SH EJEMPLOS
.RS
.nf
#include <curses.h>
#include <v32libc.c>
#include <v32curses.c>

int ink( WINDOW *win, int y, int x, int ch )
{
    if( ch == \(aq@\(aq )
        return V32INK_YELLOW;
    if( ch == \(aq#\(aq )
        return V32INK_GRAY;
    return \-1;
}

int main( void )
{
    WINDOW *status;

    initscr();
    curses_ink_hook = ink;
    status = newwin( 1, COLS, LINES \- 1, 0 );

    box( stdscr, \(aq|\(aq, \(aq\-\(aq );
    mvaddstr( 5, 10, "####" );
    mvaddch( 6, 12, \(aq@\(aq );
    refresh();

    wstandout( status );
    mvwprintw( status, 0, 0, "Level %d", 1 );
    wstandend( status );
    wrefresh( status );

    getch();
    endwin();
    return 0;
}
.fi
.RE
.SH VÉASE TAMBIÉN
.BR v32term (3v32),
.BR v32libc (3v32),
.BR v32c++ (1)
.PP
La demo Rogue,
.IR demos/c/rogue ,
en la distribución del código fuente de v32c++.
.SH AUTOR
Matthew Haas
