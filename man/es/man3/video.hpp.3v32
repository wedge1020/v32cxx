'\" -*- coding: UTF-8 -*-
.TH VIDEO.HPP 3v32 "22 de octubre de 2026" "v32c++ 20261022-dev" "Biblioteca v32c++"
.SH NOMBRE
v32/video.hpp \- ayudas de C++ para la GPU de Vircon32
.SH SINOPSIS
.nf
.B #include <v32/video.hpp>
.PP
.B namespace v32 {
.PP
.B "enum BlendMode { BlendAlpha = 0x20, BlendAdd = 0x21, BlendSubtract = 0x22 };"
.PP
.BI "void clear_screen_rgb( int " r ", int " g ", int " b " );"
.BI "void print_xy( int " x ", int " y ", int* " text " );"
.BI "void draw( int " region_id ", int " x ", int " y " );"
.BI "void draw_scaled( int " region_id ", int " x ", int " y ", float " scale " );"
.BI "void set_blending( BlendMode " mode " );"
.BI "void screen_center( Point* " out " );"
.PP
.B class TextureScope {
.BI "    TextureScope( int " texture_id " );"
.B "    ~TextureScope();"
.B };
.PP
.B class Point {
.B "public:"
.B "    int x;"
.B "    int y;"
.B "    Point();"
.BI "    Point( int " px ", int " py " );"
.BI "    void add( const Point& " other " );"
.B };
.PP
.B }
.fi
.SH DESCRIPCIÓN
.I v32/video.hpp
incluye el
.I video.h
del SDK (véase
.BR video.h (3v32)),
cuyas funciones, colores y constantes siguen disponibles tal cual, y añade lo siguiente
en el espacio de nombres
.BR v32 .
.SS Funciones
.TP
.B clear_screen_rgb
Borra la pantalla con un color opaco dado como rojo, verde y azul, de 0 a 255.
.TP
.B print_xy
Lo mismo que
.BR print_at .
.TP
.B draw
Selecciona la región
.I region_id
de la textura seleccionada y la dibuja con su punto de anclaje en
.RI ( x ", " y ).
.TP
.B draw_scaled
Lo mismo, escalado por
.I scale
en ambas direcciones. Deja la escala de dibujo fijada en
.IR scale .
.TP
.B set_blending
Establece el modo de mezcla a partir de un
.BR BlendMode .
.TP
.B screen_center
Guarda el centro de la pantalla, (320, 180), en
.IR *out .
.SS TextureScope
Un guardián de ámbito para la textura seleccionada: el constructor recuerda la textura
seleccionada y selecciona
.IR texture_id ;
el destructor, que se ejecuta cuando el guardián sale del ámbito por cualquier camino,
vuelve a seleccionar la recordada. Decláralo como variable local.
.SS Point
Un par de coordenadas
.BR int ,
(0, 0) por defecto.
.B add
suma otro punto a este en el sitio. Siguiendo la regla de una palabra para parámetros y
resultados, las funciones que producen un punto toman un
.B Point*
que rellenar en lugar de devolver uno.
.SH EJEMPLOS
.RS
.nf
#include <v32/video.hpp>
#include <v32/time.hpp>

#define TEX_SPRITES 0
#define REG_SHIP    1

void draw_hud()
{
    v32::TextureScope bios( \-1 );     // la textura de la fuente de la BIOS
    v32::print_xy( 10, 10, "SCORE 0" );
}                                     // la textura 0 vuelve a estar seleccionada

void main()
{
    select_texture( TEX_SPRITES );
    select_region( REG_SHIP );
    define_region_center( 0, 0, 31, 31 );

    v32::Point center;
    v32::screen_center( &center );

    while( true )
    {
        v32::clear_screen_rgb( 0, 0, 40 );
        v32::draw( REG_SHIP, center.x, center.y );
        draw_hud();
        end_frame();
    }
}
.fi
.RE
.SH VÉASE TAMBIÉN
.BR video.h (3v32),
