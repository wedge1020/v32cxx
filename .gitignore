# Build outputs of v32c++ (see `make clean`)
/bin/*
/obj/*
/out/
/put/*
/build/
/src/parser.output
/counterexamples.txt
/realcheck.txt
# NOTE: src/parser.c, src/lexer.c and inc/parser.h are generated but committed
# on purpose (the build works without flex/bison); do not ignore them.

# Left behind by `make realcheck` / older tooling (`make clean` removes them)
/tools/vircon32/bin/
/tools/vircon32/ComputerSoftware/
/tests/Make.sh
/tests/Make.bat

# Demo build outputs (demos/*/*/Makefile `clean`); the .wav/.png sources stay tracked
/demos/**/bin/*
/demos/**/obj/*
/demos/c/spyvsspy/sounds/m_t*.wav
/demos/**/*.v32
/demos/**/*.vbin
/demos/**/*.vtex
/demos/**/*.vsnd

# Release archives and patches (`make archive` writes ../v32cxx-project-YYYYMMDD.zip)
*.zip
*.patch

# Editor / OS litter
.DS_Store
*~
*.swp
